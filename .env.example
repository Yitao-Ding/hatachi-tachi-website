# microCMS (サーバー側のみ。NEXT_PUBLIC_ にしない)
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=

# 本番 URL (末尾スラッシュ無し)。Vercel の Production 環境変数にも同じ値を設定済み (2026-09-05)。
# 未設定でも Vercel の VERCEL_PROJECT_PRODUCTION_URL から自動判定するが、同じプロジェクトに
# 別ドメイン (studiometali.com 等) を足した時に canonical / sitemap / OGP が揺れないよう明示している。
NEXT_PUBLIC_SITE_URL=https://hatachitachi.com
